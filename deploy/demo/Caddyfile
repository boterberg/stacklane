stacklane.io {
	encode zstd gzip
	root * /usr/share/stacklane/site
	try_files {path} {path}.html {path}/index.html
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.stacklane.io {
	redir https://stacklane.io{uri} permanent
}

demo.stacklane.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}
