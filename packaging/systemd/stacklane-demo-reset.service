[Unit]
Description=Reset the Stacklane demo data
After=postgresql.service

[Service]
Type=oneshot
User=stacklane
Group=stacklane
EnvironmentFile=/etc/stacklane/stacklane.env
ExecStart=/usr/bin/stacklane demo-reset
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
