#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  if ! getent group stacklane >/dev/null; then
    addgroup --system stacklane >/dev/null
  fi
  if ! getent passwd stacklane >/dev/null; then
    adduser --system --ingroup stacklane --home /var/lib/stacklane --no-create-home --shell /usr/sbin/nologin --gecos Stacklane stacklane >/dev/null
  fi
  install -d -m 0750 -o stacklane -g stacklane /var/lib/stacklane
  runuser -u stacklane -- mkdir -p -m 0750 /var/lib/stacklane/update 2>/dev/null || true
  if ! grep -q '^SECRET_KEY=..*' /etc/stacklane/stacklane.env; then
    sed -i '/^SECRET_KEY=/d' /etc/stacklane/stacklane.env
    echo "SECRET_KEY=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')" >> /etc/stacklane/stacklane.env
  fi
  chown root:stacklane /etc/stacklane /etc/stacklane/stacklane.env
  chmod 0750 /etc/stacklane
  chmod 0640 /etc/stacklane/stacklane.env

  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable stacklane.service >/dev/null 2>&1 || true
  if [ -n "$2" ]; then
    systemctl try-restart stacklane-update.path >/dev/null 2>&1 || true
    systemctl try-restart stacklane.service >/dev/null 2>&1 || true
  else
    systemctl enable --now stacklane-update.path >/dev/null 2>&1 || true
    systemctl start stacklane.service >/dev/null 2>&1 || echo "stacklane: configure /etc/stacklane/stacklane.env and run 'systemctl start stacklane'"
  fi
fi

exit 0
